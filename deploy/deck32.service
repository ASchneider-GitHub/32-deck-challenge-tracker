[Unit]
Description=32 Deck Challenge
After=network.target

[Service]
User=deck32
Group=deck32
WorkingDirectory=/opt/deck32
Environment=DECK32_DB=/var/lib/deck32/deck32.db
ExecStart=/opt/deck32/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8032 app:app
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/deck32

[Install]
WantedBy=multi-user.target
